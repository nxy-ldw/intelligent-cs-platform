{
  "name": "ai-learning-diagnostic",
  "version": "1.0.2",
  "description": "AI个性化学习诊断辅导系统 - 桌面端",
  "main": "main.js",
  "author": "AI Learning Platform",
  "license": "Proprietary",
  "scripts": {
    "start": "electron . --no-sandbox",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:win64": "electron-builder --win --x64",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.ai.learning.diagnostic",
    "productName": "AI学习诊断",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "assets/icon.png",
      "assets/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "sign": null,
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "AI学习诊断-Portable-${version}.exe"
    }
  }
}
